# Copy to .env and fill in what you have. Everything is optional: missing sources
# fall back to the built-in simulator and are labelled "simulated" in the app.

PORT=8787
LIVE_DATA=true            # false = never touch the network (full offline demo)
AGENT_INTERVAL_MS=15000   # background agent refresh cadence

# --- The three tracked sites ---
FINVIZ_AUTH=              # Finviz Elite export token (recommended)
FINVIZ_SCRAPE=false       # or read the public quote page (check Finviz's terms first)
MESARRI_URL=              # e.g. https://api.mesarri.io/v1/score/{symbol}  ({symbol} is substituted)
MESARRI_API_KEY=
MESARRI_MAP=sentiment=sentiment,score=score,headline=headline
INVO_URL=                 # e.g. https://app.invoapp.com/api/...{symbol}
INVO_API_KEY=
INVO_MAP=sentiment=sentiment,score=score,headline=headline
YAHOO_HISTORY=true        # free daily history for training/backtests

# --- BTC latency engine ---
POLY_UP_TOKEN=            # optional: pin token ids; otherwise auto-discovered via Gamma
POLY_DOWN_TOKEN=
POLY_SLUG_PREFIX=btc-updown-5m
CRYPTOQUANT_API_KEY=
TRADINGVIEW_WEBHOOK_SECRET=change-me
BOT_BANKROLL=1000
BOT_PER_TRADE_RISK_PCT=0.5
BOT_DAILY_CAP_PCT=2
BOT_HARD_STOP_PCT=0.4
BOT_LAG_TRIGGER_PCT=0.3
BOT_TP_MIN_PCT=0.3
BOT_TP_MAX_PCT=0.8
BOT_MIN_EDGE=0.02
BOT_EVAL_HZ=20
BOT_MAX_ORDERS_PER_SEC=5

# --- Web Push (auto-generated and stored locally if left empty) ---
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
